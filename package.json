{
  "name": "medclinic-taf",
  "version": "1.0.0",
  "description": "Test Automation Framework for MedClinic Portal (MedTech / Healthcare)",
  "type": "module",
  "scripts": {
    "app": "node app/server.js",
    "bddgen": "bddgen",
    "test": "bddgen && playwright test",
    "test:smoke": "bddgen && playwright test --grep @smoke",
    "test:api": "playwright test --project=api",
    "test:gui": "bddgen && playwright test --project=gui --project=bdd",
    "report": "allure generate ./allure-results",
    "test:stability": "bddgen && playwright test --repeat-each=3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "allure": "^3.33.0",
    "allure-playwright": "^3.14.0",
    "playwright-bdd": "^9.2.1"
  },
  "dependencies": {
    "express": "^5.3.0"
  }
}